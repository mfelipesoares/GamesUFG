# Copie para ".env" (na raiz) antes de subir em produção: cp .env.example .env
# O docker compose lê este arquivo automaticamente. Gere segredos com: openssl rand -hex 32

# JWT do login do usuário: o gateway (core) assina; wordle, forca e ranking validam.
AUTH_JWT_SECRET=troque-por-um-valor-aleatorio

# JWT entre microsserviços (wordle/forca -> palavras e ranking). Diferente do de cima.
INTERNAL_SERVICE_SECRET=troque-por-outro-valor-aleatorio

# Senhas dos bancos (uma instância PostgreSQL por microsserviço)
WORDLE_DB_PASSWORD=troque-esta-senha
FORCA_DB_PASSWORD=troque-esta-senha
PALAVRAS_DB_PASSWORD=troque-esta-senha
RANKING_DB_PASSWORD=troque-esta-senha

# Jogos que cada usuário pode iniciar por dia, em cada jogo
DAILY_GAME_LIMIT=5
